{
  "appId": "com.nookra.app",
  "productName": "Nookra",
  "artifactName": "${productName}.${ext}",
  "files": [
    "dist/**/*",
    "!dist/mac-arm64",
    "!dist/win-unpacked",
    "!dist/*.dmg",
    "!dist/*.exe",
    "!dist/*.blockmap",
    "electron/**/*",
    "main.js",
    "preload.js",
    "package.json"
  ],
  "directories": {
    "buildResources": "build"
  },
  "mac": {
    "target": "dmg",
    "category": "public.app-category.finance",
    "icon": "build/icon.icns"
  },
  "dmg": {
    "title": "Nookra",
    "background": "build/dmg-background.png",
    "iconSize": 128,
    "iconTextSize": 12,
    "window": {
      "width": 600,
      "height": 450
    },
    "contents": [
      { "x": 160, "y": 180, "type": "file" },
      { "x": 440, "y": 180, "type": "link", "path": "/Applications" }
    ]
  },
  "win": {
    "target": "nsis",
    "icon": "build/icon.ico"
  }
}
