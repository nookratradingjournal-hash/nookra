{
  "appId": "com.nookra.admin",
  "productName": "Nookra Admin",
  "extraMetadata": {
    "main": "main-admin.js"
  },
  "files": [
    "dist-admin/**/*",
    "electron/**/*",
    "main-admin.js",
    "preload.js",
    "package.json"
  ],
  "directories": {
    "buildResources": "build"
  },
  "mac": {
    "target": "dmg",
    "icon": "build/icon-admin.icns"
  },
  "dmg": {
    "title": "Nookra Admin",
    "backgroundColor": "#09090b",
    "window": {
      "width": 540,
      "height": 380
    },
    "contents": [
      { "x": 140, "y": 190, "type": "file" },
      { "x": 400, "y": 190, "type": "link", "path": "/Applications" }
    ]
  },
  "win": {
    "target": "nsis",
    "icon": "build/icon-admin.ico"
  }
}
